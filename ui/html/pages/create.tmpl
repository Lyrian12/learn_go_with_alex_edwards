{{ define "title" }} create a New Snippet{{end}}
{{define "main"}}
<form action="/create" method="POST">
<div>
<label for="title">Title:</label>
{{with .Form.Errors.title}}<span class="error">{{.}}</span>{{end}}
<input id="title" type="text" name="title" value="{{.Form.Title}}" maxlength="50" required>
</div>
<div>
<label for="content">Content:</label>
{{with .Form.Errors.content}}<span class="error">{{.}}</span>{{end}}
<textarea id="content" name="content" required>{{.Form.Content}}</textarea>
</div>
<div>
<label>Delete in:</label>
{{with .Form.Errors.expires}}<span class="error">{{.}}</span>{{end}}
<input type="radio" name="expires" value="365" {{if eq .Form.Expires "365"}}checked{{end}} required> one year
<input type="radio" name="expires" value="7" {{if eq .Form.Expires "7"}}checked{{end}}> one week
<input type="radio" name="expires" value="1" {{if eq .Form.Expires "1"}}checked{{end}}> one day
</div>
<div>
<input type="submit" value="publish snippet">
</div>
</form>
{{end}}